# SPA-Fallback: unbekannte Pfade an index.html weiterreichen,
# damit ein Reload auf z. B. /imprint keinen 404 erzeugt.

DirectoryIndex index.html

# Weg 1 (sauber, Status 200): braucht mod_rewrite.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Kein RewriteBase: funktioniert im Domain-Root und im Unterordner.

  # Vorhandene Dateien und Ordner unveraendert ausliefern.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Alles andere uebernimmt der Angular-Router.
  RewriteRule ^ index.html [L]
</IfModule>

# Weg 2 (Notnagel, Status 404): greift nur, wenn mod_rewrite fehlt.
# Der Pfad ist ab Domain-Wurzel absolut. Liegt die App in einem
# Unterordner, hier anpassen: ErrorDocument 404 /DABubble/index.html
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
