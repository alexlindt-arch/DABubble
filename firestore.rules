rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Gäste sind anonyme Testkonten: Sie dürfen überall mitschreiben, ihre Spuren
    // werden nach 15 Minuten wieder gelöscht.
    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Ist das 15-Minuten-Fenster eines Gastes abgelaufen, darf jeder Angemeldete aufräumen.
    // Das Profil ist der Nachweis dafür und wird deshalb immer zuletzt gelöscht.
    function isExpiredGuest(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('guestUntil', request.time) < request.time;
    }

    function isExpiredGuestChannel(channelId) {
      return isExpiredGuest(get(/databases/$(database)/documents/channels/$(channelId)).data.createdBy);
    }

    function isExpiredGuestChat(chatId) {
      return chatMembers(chatId).hasAny([request.auth.uid])
        && (isExpiredGuest(chatMembers(chatId)[0]) || isExpiredGuest(chatMembers(chatId)[1]));
    }

    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
    }

    function isChannelMember(channelId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members;
    }

    function isChannelCreator(channelId) {
      return signedIn()
        && request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.createdBy;
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/directChats/$(chatId));
    }

    // Die Chat-ID besteht aus beiden UIDs. Solange noch keine Nachricht geschrieben wurde,
    // fehlt das Eltern-Dokument - dann entscheidet die ID ueber die Zugehoerigkeit.
    function ownsChatId(chatId) {
      return signedIn() && chatId.split('_').hasAny([request.auth.uid]);
    }

    function isPublicChannelName(name) {
      return name == 'Allgemein' || name == 'News' || name == 'Willkommenschannel';
    }

    function canJoinPublicChannel(channelId) {
      return signedIn()
        && isPublicChannelName(get(/databases/$(database)/documents/channels/$(channelId)).data.name)
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
    }

    function isDirectChatMember(chatId) {
      return signedIn() && chatExists(chatId)
        && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
    }

    function isDirectChatMemberAfter(chatId) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/directChats/$(chatId)).data.members;
    }

    function isLastOwnDirectMessage(chatId, messageId) {
      return request.auth.uid == resource.data.senderId
        && get(/databases/$(database)/documents/directChats/$(chatId)).data.lastMessageId == messageId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']);
    }

    // Profile dürfen angemeldete Personen lesen, damit die Personenliste funktioniert.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && (request.auth.uid == userId || isExpiredGuest(userId));
    }

    // Channels bleiben für das gemeinsame Projekt lesbar. Nachrichten schreiben dürfen nur Mitglieder.
    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && (request.auth.uid in resource.data.members || isGuest() || canJoinPublicChannel(channelId));
      allow delete: if (signedIn() && request.auth.uid in resource.data.members)
        || (isGuest() && request.auth.uid == resource.data.createdBy)
        || isExpiredGuest(resource.data.createdBy);

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && (isChannelMember(channelId) || isGuest());
        allow update: if isChannelMember(channelId) || isGuest();
        // Aufräumen der Gast-Sitzung: eigene Beiträge und alles im eigenen Gast-Channel.
        allow delete: if (isGuest()
            && (resource.data.senderId == request.auth.uid || isChannelCreator(channelId)))
          || isExpiredGuest(resource.data.senderId)
          || isExpiredGuestChannel(channelId)
          || isChannelMember(channelId);
      }
    }

    // Private Chats: Nur die zwei IDs in "members" können sie lesen oder verändern.
    match /directChats/{chatId} {
      // Ein leerer Chat hat noch kein Dokument: Dann zaehlt die ID statt "members".
      allow read: if signedIn()
        && (resource == null ? ownsChatId(chatId) : request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      // Der Chat-Partner darf die Reste eines abgelaufenen Gastes selbst wegräumen.
      allow delete: if signedIn() && request.auth.uid in resource.data.members
        && (!isGuest()
          || isExpiredGuest(resource.data.members[0])
          || isExpiredGuest(resource.data.members[1]));

      match /messages/{messageId} {
        allow read: if isDirectChatMember(chatId) || (ownsChatId(chatId) && !chatExists(chatId));
        allow create: if isDirectChatMemberAfter(chatId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isDirectChatMember(chatId)
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            || isLastOwnDirectMessage(chatId, messageId)
          );
        allow delete: if isDirectChatMember(chatId)
          && (!isGuest() || isExpiredGuestChat(chatId));
      }
    }
  }
}
